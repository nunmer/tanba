# Copy to .env and edit for local dev.

ENV=local

# Postgres (async DSN — uses asyncpg driver)
DATABASE_URL=postgresql+asyncpg://tanba:tanba@localhost:5433/tanba

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (dashboard)
JWT_SECRET=dev-only-secret-change-me-min-32-bytes-long
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=1209600     # seconds (14 days)

# Routing / cache
ROUTE_CACHE_TTL=300         # seconds a resolved route stays cached
PUBLIC_BASE_URL=http://localhost:8001

# CORS: browser origins allowed to call the dashboard API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Analytics (later milestones)
EVENT_STREAM=tanba:events
GEOIP_DB_PATH=
